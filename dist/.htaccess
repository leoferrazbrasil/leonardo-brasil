# SPA + cache — Leonardo Brasil (Hostinger/Apache/LiteSpeed)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Redirecionamento 301 de www para non-www (consolidação SEO)
  RewriteCond %{HTTP_HOST} ^www\.leonardobrasil\.com\.br$ [NC]
  RewriteRule ^(.*)$ https://leonardobrasil.com.br/$1 [R=301,L]

  # Serve arquivos/pastas existentes normalmente
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  # Fallback SPA para index.html
  RewriteRule ^ index.html [L]
</IfModule>

# index.html sempre fresco; assets com hash são imutáveis
<IfModule mod_headers.c>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(js|css|woff2?|png|jpe?g|svg|webp|avif)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
